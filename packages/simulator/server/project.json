{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "simulator-server",
  "projectType": "application",
  "tags": ["scope:simulator", "lang:rust"],
  "implicitDependencies": ["firmware", "shared", "simulator-web-ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["rust"],
      "options": { "command": "cargo build -p smokebomb-simulator --features simulator", "cwd": "{workspaceRoot}" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["simulator-web-ui"], "target": "build" }],
      "continuous": true,
      "options": { "command": "cargo run --features=simulator", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["rust"],
      "options": {
        "command": "cargo clippy -p smokebomb-simulator --all-targets -- -D warnings",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
