{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shared",
  "projectType": "library",
  "tags": ["scope:shared", "lang:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["rust"],
      "options": { "command": "cargo build -p smokebomb-shared", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["rust"],
      "options": { "command": "cargo test -p smokebomb-shared", "cwd": "{workspaceRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["rust"],
      "options": { "command": "cargo clippy -p smokebomb-shared --all-targets -- -D warnings", "cwd": "{workspaceRoot}" }
    }
  }
}
